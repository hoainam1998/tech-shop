datasource db {
  provider = "postgresql"
  schemas  = ["admin", "customer", "employee"]
}

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/tech-shop"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Status {
  IN_STOCK
  OLD
  LESS

  @@schema("customer")
}

enum Employee_position_admin {
  OPERATOR
  CLEANING_STAFF

  @@map("Employee_position")
  @@schema("admin")
}

enum Employee_position_customer {
  OPERATOR
  CLEANING_STAFF

  @@map("Employee_position")
  @@schema("customer")
}

enum Employee_position_employee {
  OPERATOR
  CLEANING_STAFF

  @@map("Employee_position")
  @@schema("employee")
}

enum Leave_status_admin {
  APPROVED
  PENDING
  NOT_APPROVED

  @@map("Leave_status")
  @@schema("admin")
}

enum Leave_status_employee {
  APPROVED
  PENDING
  NOT_APPROVED

  @@map("Leave_status")
  @@schema("employee")
}

model category {
  category_id String             @id @default(uuid(7)) @db.Uuid
  name        String             @db.VarChar(200)
  icon        String             @db.Text
  product     product_customer[]

  @@schema("customer")
}

model brand {
  brand_id String             @id @default(uuid(7)) @db.Uuid
  name     String             @db.VarChar(200)
  icon     String             @db.Text
  product  product_customer[]

  @@schema("customer")
}

model product_customer {
  product_id  String   @id @db.Uuid
  name        String
  avatar      String   @db.Text
  amount      Int
  price       Int
  status      Status   @default(IN_STOCK)
  category_id String   @db.Uuid
  category    category @relation(fields: [category_id], references: category_id, onDelete: NoAction, onUpdate: NoAction, map: "FK_CATEGORY")
  brand_id    String   @db.Uuid
  brand       brand    @relation(fields: [brand_id], references: brand_id, onDelete: NoAction, onUpdate: NoAction, map: "FK_BRAND")

  @@index([name, category_id, brand_id])
  @@map("product")
  @@schema("customer")
}

model product_admin {
  product_id              String                    @id @db.Uuid
  name                    String
  product_relocate_detail product_relocate_detail[]
  product_export_detail   product_export_detail[]
  product_import_detail   product_import_detail[]

  @@map("product")
  @@schema("admin")
}

model user_admin {
  user_id                      String                         @id @db.Uuid
  first_name                   String                         @db.VarChar(200)
  last_name                    String                         @db.VarChar(20)
  avatar                       String?                        @db.Text
  password                     String                         @unique @db.VarChar(100)
  sex                          Boolean                        @default(true)
  power                        Int                            @default(0) @db.SmallInt
  phone                        String                         @unique @db.VarChar(11)
  email                        String                         @unique @db.VarChar(100)
  active                       Boolean                        @default(true)
  session_id                   String?                        @unique @db.VarChar(100)
  reset_password_token         String?                        @db.Text
  api_key                      String?                        @db.Text
  product_import               product_import[]
  product_export               product_export[]
  product_relocate             product_relocate[]
  request_employee_leave_admin request_employee_leave_admin[]

  @@index([user_id, email])
  @@schema("admin")
  @@map("user")
}

model user_employee {
  user_id                         String                            @id @db.Uuid
  name                            String                            @db.VarChar(250)
  request_employee_leave_employee request_employee_leave_employee[]

  @@map("user")
  @@schema("employee")
}

model user_customer {
  user_id String @id @db.Uuid
  name    String @db.VarChar(250)

  @@map("user")
  @@schema("customer")
}

model warehouse_admin {
  warehouse_id             String                     @id @db.Uuid
  num                      Int                        @db.SmallInt
  height                   Int                        @db.SmallInt
  width                    Int                        @db.SmallInt
  squares                  Int                        @db.SmallInt
  status                   Int                        @default(0) @db.SmallInt
  valid                    Int                        @default(0) @db.SmallInt
  product_export           product_export[]
  product_import           product_import[]
  customer_warehouse_admin customer_warehouse_admin[]
  warehouse_operator_admin warehouse_operator_admin[]
  old_warehouse            product_relocate[]         @relation("old_warehouse")
  new_warehouse            product_relocate[]         @relation("new_warehouse")

  @@schema("admin")
  @@map("warehouse")
}

model warehouse_customer {
  warehouse_id                String                        @id @db.Uuid
  num                         Int                           @db.SmallInt
  height                      Int                           @db.SmallInt
  width                       Int                           @db.SmallInt
  squares                     Int                           @db.SmallInt
  status                      Int                           @default(0) @db.SmallInt
  customer_warehouse_customer customer_warehouse_customer[]
  warehouse_operator_customer warehouse_operator_customer[]

  @@schema("customer")
  @@map("warehouse")
}

model warehouse_employee {
  warehouse_id String @id @db.Uuid
  num          Int    @db.SmallInt

  @@schema("employee")
  @@map("warehouse")
}

model customer_customer {
  customer_id                 String                        @id @db.Uuid
  name                        String                        @db.VarChar(250)
  avatar                      String?                       @db.Text
  password                    String                        @unique @db.VarChar(100)
  phone                       String                        @unique @db.VarChar(11)
  email                       String                        @unique @db.VarChar(100)
  active                      Boolean                       @default(true)
  reset_password_token        String?                       @unique @db.Text
  customer_warehouse_customer customer_warehouse_customer[]

  @@map("customer")
  @@schema("customer")
}

model customer_admin {
  customer_id              String                     @id @db.Uuid
  first_name               String                     @db.VarChar(200)
  last_name                String                     @db.VarChar(20)
  avatar                   String?                    @db.Text
  password                 String                     @unique @db.VarChar(100)
  sex                      Boolean                    @default(true)
  phone                    String                     @unique @db.VarChar(11)
  email                    String                     @unique @db.VarChar(100)
  active                   Boolean                    @default(true)
  reset_password_token     String?                    @unique @db.Text
  customer_warehouse_admin customer_warehouse_admin[]

  @@map("customer")
  @@schema("admin")
}

model employee_admin {
  employee_id                  String                         @id @db.Uuid
  first_name                   String                         @db.VarChar(200)
  last_name                    String                         @db.VarChar(20)
  position                     Employee_position_admin
  avatar                       String?                        @db.Text
  password                     String                         @unique @db.VarChar(100)
  sex                          Boolean                        @default(true)
  phone                        String                         @unique @db.VarChar(11)
  email                        String                         @unique @db.VarChar(100)
  active                       Boolean                        @default(true)
  valid                        Boolean                        @default(true)
  on_leave_start               String                         @db.VarChar(13)
  on_leave_end                 String                         @db.VarChar(13)
  reset_password_token         String?                        @unique @db.Text
  request_employee_leave_admin request_employee_leave_admin[]
  request_relocate_staff       request_relocate_staff[]
  request_export_staff         request_export_staff[]
  request_import_staff         request_import_staff[]
  warehouse_operator_admin     warehouse_operator_admin[]

  @@map("employee")
  @@schema("admin")
}

model employee_employee {
  employee_id                     String                            @id @db.Uuid
  name                            String                            @db.VarChar(250)
  position                        Employee_position_employee
  avatar                          String?                           @db.Text
  password                        String                            @unique @db.VarChar(100)
  phone                           String                            @unique @db.VarChar(11)
  email                           String                            @unique @db.VarChar(100)
  active                          Boolean                           @default(true)
  valid                           Boolean                           @default(true)
  on_leave_start                  String                            @db.VarChar(13)
  on_leave_end                    String                            @db.VarChar(13)
  reset_password_token            String?                           @unique @db.Text
  request_employee_leave_employee request_employee_leave_employee[]

  @@map("employee")
  @@schema("employee")
}

model employee_customer {
  employee_id                 String                        @id @db.Uuid
  name                        String                        @db.VarChar(250)
  position                    Employee_position_customer
  avatar                      String?                       @db.Text
  valid                       Boolean                       @default(true)
  on_leave_start              String                        @db.VarChar(13)
  on_leave_end                String                        @db.VarChar(13)
  warehouse_operator_customer warehouse_operator_customer[]

  @@map("employee")
  @@schema("customer")
}

model warehouse_operator_admin {
  warehouse_id String          @db.Uuid
  employee_id  String          @db.Uuid
  warehouse    warehouse_admin @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_WAREHOUSE_OPERATOR_ADMIN")
  employee     employee_admin  @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_WAREHOUSE_OPERATOR_ADMIN")

  @@id([warehouse_id, employee_id])
  @@map("warehouse_operator")
  @@schema("admin")
}

model warehouse_operator_customer {
  warehouse_id String             @db.Uuid
  employee_id  String             @db.Uuid
  warehouse    warehouse_customer @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_WAREHOUSE_OPERATOR_CUSTOMER")
  employee     employee_customer  @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_WAREHOUSE_OPERATOR_CUSTOMER")

  @@id([warehouse_id, employee_id])
  @@map("warehouse_operator")
  @@schema("customer")
}

model customer_warehouse_admin {
  customer_id  String          @db.Uuid
  warehouse_id String          @db.Uuid
  customer     customer_admin  @relation(fields: [customer_id], references: customer_id, map: "FK_CUSTOMER_WAREHOUSE_CUSTOMER_ADMIN")
  warehouse    warehouse_admin @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_CUSTOMER_WAREHOUSE_WAREHOUSE_ADMIN")

  @@id([customer_id, warehouse_id])
  @@map("customer_warehouse")
  @@schema("admin")
}

model customer_warehouse_customer {
  customer_id  String             @db.Uuid
  warehouse_id String             @db.Uuid
  customer     customer_customer  @relation(fields: [customer_id], references: customer_id, map: "FK_CUSTOMER_WAREHOUSE_CUSTOMER")
  warehouse    warehouse_customer @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_CUSTOMER_WAREHOUSE_WAREHOUSE")

  @@id([customer_id, warehouse_id])
  @@map("customer_warehouse")
  @@schema("customer")
}

model product_import {
  id                    String                  @id @db.Uuid
  warehouse_id          String                  @db.Uuid
  approver              String                  @db.Uuid
  at                    String                  @db.VarChar(13)
  amount_items          Int                     @db.SmallInt
  product_import_detail product_import_detail[]
  request_import_staff  request_import_staff[]
  warehouse             warehouse_admin         @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_WAREHOUSE_PRODUCT_IMPORT")
  user                  user_admin              @relation(fields: [approver], references: user_id, map: "FK_USER_PRODUCT_IMPORT")

  @@schema("admin")
}

model product_import_detail {
  id             String         @db.Uuid
  product_id     String         @db.Uuid
  amount         Int            @db.SmallInt
  product_import product_import @relation(fields: [id], references: id, map: "FK_PRODUCT_IMPORT")
  product        product_admin  @relation(fields: [product_id], references: product_id, map: "FK_PRODUCT_IMPORT_DETAIL")

  @@id([id, product_id])
  @@schema("admin")
}

model request_import_staff {
  request_id      String         @db.Uuid
  employee_id     String         @db.Uuid
  work_start_time String         @db.VarChar(13)
  work_end_time   String         @db.VarChar(13)
  product_import  product_import @relation(fields: [request_id], references: id, map: "FK_REQUEST_IMPORT_STAFF")
  employee        employee_admin @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_REQUEST_IMPORT")

  @@id([request_id, employee_id])
  @@schema("admin")
}

model product_export {
  id                    String                  @id @db.Uuid
  warehouse_id          String                  @db.Uuid
  approver              String                  @db.Uuid
  at                    String                  @db.VarChar(13)
  amount_items          Int                     @db.SmallInt
  product_export_detail product_export_detail[]
  request_export_staff  request_export_staff[]
  warehouse             warehouse_admin         @relation(fields: [warehouse_id], references: warehouse_id, map: "FK_WAREHOUSE_PRODUCT_EXPORT")
  user                  user_admin              @relation(fields: [approver], references: user_id, map: "FK_USER_PRODUCT_EXPORT")

  @@schema("admin")
}

model product_export_detail {
  id             String         @db.Uuid
  product_id     String         @db.Uuid
  amount         Int            @db.SmallInt
  product_export product_export @relation(fields: [id], references: id, map: "FK_PRODUCT_EXPORT")
  product        product_admin  @relation(fields: [product_id], references: product_id, map: "FK_PRODUCT_EXPORT_DETAIL")

  @@id([id, product_id])
  @@schema("admin")
}

model request_export_staff {
  request_id      String         @db.Uuid
  employee_id     String         @db.Uuid
  work_start_time String         @db.VarChar(13)
  work_end_time   String         @db.VarChar(13)
  product_export  product_export @relation(fields: [request_id], references: id, map: "FK_REQUEST_EXPORT_STAFF")
  employee        employee_admin @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_REQUEST_EXPORT")

  @@id([request_id, employee_id])
  @@schema("admin")
}

model product_relocate {
  id                      String                    @id @db.Uuid
  approver                String                    @db.Uuid
  old_warehouse_id        String                    @db.Uuid
  new_warehouse_id        String                    @db.Uuid
  at                      String                    @db.VarChar(13)
  amount_items            Int                       @db.SmallInt
  product_relocate_detail product_relocate_detail[]
  request_relocate_staff  request_relocate_staff[]
  user                    user_admin                @relation(fields: [approver], references: user_id, map: "FK_USER_PRODUCT_RELOCATE")

  old_warehouse warehouse_admin @relation("old_warehouse", fields: [old_warehouse_id], references: warehouse_id, map: "FK_OLD_WAREHOUSE_PRODUCT_RELOCATE")
  new_warehouse warehouse_admin @relation("new_warehouse", fields: [new_warehouse_id], references: warehouse_id, map: "FK_NEW_WAREHOUSE_PRODUCT_RELOCATE")

  @@schema("admin")
}

model product_relocate_detail {
  id               String           @db.Uuid
  product_id       String           @db.Uuid
  amount           Int              @db.SmallInt
  product_relocate product_relocate @relation(fields: [id], references: id, map: "FK_PRODUCT_RELOCATE")
  product          product_admin    @relation(fields: [product_id], references: product_id, map: "FK_PRODUCT_RELOCATE_DETAIL")

  @@id([id, product_id])
  @@schema("admin")
}

model request_relocate_staff {
  request_id       String           @db.Uuid
  employee_id      String           @db.Uuid
  work_start_time  String           @db.VarChar(13)
  work_end_time    String           @db.VarChar(13)
  product_relocate product_relocate @relation(fields: [request_id], references: id, map: "FK_REQUEST_RELOCATE_STAFF")
  employee         employee_admin   @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_REQUEST_LOCATE")

  @@id([request_id, employee_id])
  @@schema("admin")
}

model request_employee_leave_admin {
  id          String             @id @db.Uuid
  employee_id String             @db.Uuid
  approver    String             @db.Uuid
  status      Leave_status_admin @default(PENDING)
  start       String             @db.VarChar(13)
  end         String             @db.VarChar(13)
  employee    employee_admin     @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_LEAVE_ADMIN")
  user        user_admin         @relation(fields: [approver], references: user_id, map: "FK_ADMIN_EMPLOYEE_LEAVE_EMPLOYEE")

  @@map("request_employee_leave")
  @@schema("admin")
}

model request_employee_leave_employee {
  id          String                @id @db.Uuid
  employee_id String                @db.Uuid
  approver    String                @db.Uuid
  status      Leave_status_employee @default(PENDING)
  start       String                @db.VarChar(13)
  end         String                @db.VarChar(13)
  employee    employee_employee     @relation(fields: [employee_id], references: employee_id, map: "FK_EMPLOYEE_LEAVE_EMPLOYEE")
  user        user_employee         @relation(fields: [approver], references: user_id, map: "FK_USER_EMPLOYEE_LEAVE_EMPLOYEE")

  @@map("request_employee_leave")
  @@schema("employee")
}
