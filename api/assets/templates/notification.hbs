<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Welcome to Our Platform</title>
	<style>
		.header {
			display: flex;
			margin-bottom: 10px;
		}

		.announcement-group {
			margin-left: 10px;
		}

		.announcement	{
			margin: 0 0 10px 0;
		}

		.logo {
			width: 50px;
			height: 50px;
		}

		table {
			font-family: arial, sans-serif;
			border-collapse: collapse;
			width: 100%;
		}

		td,
		th {
			border: 1px solid #dddddd;
			text-align: left;
			padding: 8px;
		}
	</style>
</head>

<body>
	<div class="header">
		<img class="logo" src="cid:logoImage" alt="store" />
		<div class="announcement-group">
			<h3 class="announcement">Tech shop system announcement!</h3>
			<span>You have {{toLowerCase information.type}} notification:</span>
		</div>
	</div>
	<table>
		<thead>
			<tr>
				<th>icon</th>
				{{#each information}}
				<th><strong>{{@key}}</strong></th>
				{{/each}}
			</tr>
		</thead>
		<tbody>
			<tr>
				<td><img class="logo" src="cid:notificationIcon" alt="notification_icon" /></td>
				{{#each information}}
				<td>
					<pre>{{this}}</pre>
				</td>
				{{/each}}
			</tr>
		</tbody>
	</table>
</body>
</html>